# Copy to .env (git-ignored) and fill in. Never commit .env.

# Required for any live EDGAR call. SEC asks automated users to identify themselves.
# Format: "<tool name> <contact email>"
SEC_USER_AGENT=

# Finnhub API key (price and analyst data, development use only until written permission, ADR-007). Not needed yet.
FINNHUB_API_KEY=

# Google Gemini API key (LLM steps). Not needed yet.
GEMINI_API_KEY=

# Which model profile config/models.json uses. Default: gemini-3.1-flash-lite.
LLM_PROFILE=

# Paid calls (beyond the free daily quota) are refused unless this is exactly "true" (ADR-023, ADR-039).
PAID_MODE_ENABLED=
