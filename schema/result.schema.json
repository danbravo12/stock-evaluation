  "Citation": {
   "description": "A cited span of a passage, by sentence pointer: normalised_document_text[char_start:char_end] == quote, exactly (ADR-035, ADR-042).\n\nThe model gives passage_id and sentence numbers; code builds the quote and the offsets, so they cannot mismatch (ADR-046).",
   "properties": {
    "accession": {
     "title": "Accession",
     "type": "string"
    },
    "char_end": {
     "title": "Char End",
     "type": "integer"
    },
    "char_start": {
     "title": "Char Start",
     "type": "integer"
    },
    "item": {
     "title": "Item",
     "type": "string"
    },
    "passage_id": {
     "title": "Passage Id",
     "type": "string"
    },
    "quote": {
     "title": "Quote",
     "type": "string"
    },
    "sentences": {
     "items": {
      "type": "integer"
     },
     "title": "Sentences",
     "type": "array"
    }
   },
   "required": [
    "passage_id",
    "accession",
    "item",
    "char_start",
    "char_end",
    "quote",
    "sentences"
   ],
   "title": "Citation",
   "type": "object"
  },
