,"source_url":"https://www.sec.gov/Archives/edgar/data/1652044/000165204426000018/","flags":[]},{"measure":"stockholders_equity","fiscal_year":2015,"fiscal_year_end":"2015-12-31","value":120331000000.0,"unit":"USD","concept":"StockholdersEquity","accession":"0001652044-19-000004","source_url":"https://www.sec.gov/Archives/edgar/data/1652044/000165204419000004/","flags":[]},{"measure":"stockholders_equity","fiscal_year":2016,"fiscal_year_end":"2016-12-31","value":139036000000.0,"unit":"USD","concept":"StockholdersEquity","accession":"0001652044-20-000008","source_url":"https://www.sec.gov/Archives/edgar/data/1652044/000165204420000008/","flags":[]},{"measure":"stockholders_equity","fiscal_year":2017,"fiscal_year_end":"2017-12-31","value":152502000000.0,"unit":"USD","concept":"StockholdersEquity","accession":"0001652044-21-000010","source_url":"https://www.sec.gov/Archives/edgar/data/1652044/000165204421000010/","flags":[]},{"measure":"stockholders_equity","fiscal_year":2018,"fiscal_year_end":"2018-12-31","value":177628000000.0,"unit":"USD","concept":"StockholdersEquity","accession":"0001652044-22-000019","source_url":"https://www.sec.gov/Archives/edgar/data/1652044/000165204422000019/","flags":[]},{"measure":"stockholders_equity","fiscal_year":2019,"fiscal_year_end":"2019-12-31","value":201442000000.0,"unit":"USD","concept":"StockholdersEquity","accession":"0001652044-23-000016","source_url":"https://www.sec.gov/Archives/edgar/data/1652044/000165204423000016/","flags":[]},{"measure":"stockholders_equity","fiscal_year":2020,"fiscal_year_end":"2020-12-31","value":222544000000.0,"unit":"USD","concept":"StockholdersEquity","accession":"0001652044-24-000022","source_url":"https://www.sec.gov/Archives/edgar/data/1652044/000165204424000022/","flags":[]},{"measure":"stockholders_equity","fiscal_year":2021,"fiscal_year_end":"2021-12-31","value":251635000000.0,"unit":"USD","concept":"StockholdersEquity","accession":"0001652044-25-000014","source_url":"https://www.sec.gov/Archives/edgar/data/1652044/000165204425000014/","flags":[]},{"measure":"stockholders_equity","fiscal_year":2022,"fiscal_year_end":"2022-12-31","value":256144000000.0,"unit":"USD","concept":"StockholdersEquity","accession":"0001652044-26-000018","source_url":"https://www.sec.gov/Archives/edgar/data/1652044/000165204426000018/","flags":[]},{"measure":"stockholders_equity","fiscal_year":2023,"fiscal_year_end":"2023-12-31","value":283379000000.0,"unit":"USD","concept":"StockholdersEquity","accession":"0001652044-26-000018","source_url":"https://www.sec.gov/Archives/edgar/data/1652044/000165204426000018/","flags":[]},{"measure":"stockholders_equity","fiscal_year":2024,"fiscal_year_end":"2024-12-31","value":325084000000.0,"unit":"USD","concept":"StockholdersEquity","accession":"0001652044-26-000018","source_url":"https://www.sec.gov/Archives/edgar/data/1652044/000165204426000018/","flags":[]},{"measure":"stockholders_equity","fiscal_year":2025,"fiscal_year_end":"2025-12-31","value":415265000000.0,"unit":"USD","concept":"StockholdersEquity","accession":"0001652044-26-000018","source_url":"https://www.sec.gov/Archives/edgar/data/1652044/000165204426000018/","flags":[]}],"sector_notes":[]},"qualitative":[{"finding":{"criterion":"understandable_business","verdict":"evidence found","rationale":"The filing explains that Google generates revenue through advertising, consumption-based fees and subscriptions for cloud services, consumer subscriptions (such as YouTube and Google One), app sales, and hardware device sales. It identifies its customers as advertisers, individual consumers, and enterprise/developer users of its cloud and AI infrastructure.","citations":[{"passage_id":"0001652044-26-000018:1:12","accession":"0001652044-26-000018","item":"1","char_start":22889,"char_end":23112,"quote":"Through our Google Cloud Platform and Google Workspace offerings, Google Cloud generates revenues primarily from consumption-based fees and subscriptions for infrastructure, platform, applications, and other cloud services.","sentences":[1,1]},{"passage_id":"0001652044-26-000018:1:11","accession":"0001652044-26-000018","item":"1","char_start":22367,"char_end":22875,"quote":"In addition, Google Services generates revenues from products and services beyond advertising, including:\n•consumer subscriptions, which primarily include revenues from YouTube services, such as YouTube TV, YouTube Music and Premium, and NFL Sunday Ticket, as well as Google One, which offers access to our most capable Gemini models;\n•platforms, which primarily include revenues from Google Play sales of apps and in-app purchases; and\n•devices, which primarily include sales of the Pixel family of devices.","sentences":[5,8]}],"searches":[{"queries":["principal products services","how we generate revenue","segments","customers","business model"],"items":["1"],"seeded":true,"passage_ids":["0001652044-26-000018:1:12","0001652044-26-000018:1:15","0001652044-26-000018:1:11","0001652044-26-000018:1:4"]}],"llm_calls":1,"tool_calls":2,"stop_reason":"submitted","usage":{"prompt_tokens":2267,"completion_tokens":167,"total_tokens":2434,"reasoning_tokens":0},"actual_cost_usd":0.0,"notional_cost_usd":0.00081725},"critic_status":"passed"},{"finding":{"criterion":"durable_competitive_advantage","verdict":"evidence weak","rationale":"The filing asserts the importance of brands and intellectual property but does not provide concrete, quantified evidence of a durable competitive advantage, such as specific market share figures or exclusive franchise terms. Furthermore, the filing explicitly notes that competitors can readily erode the company's position, as users can switch to other services with a single click.","citations":[{"passage_id":"0001652044-26-000018:1A:15","accession":"0001652044-26-000018","item":"1A","char_start":51201,"char_end":51719,"quote":"Any significant impairment of our intellectual property rights could harm our business and ability to compete. Protecting our intellectual property rights is costly and time consuming; any increase in unauthorized use could make it more expensive to do business and harm our financial condition and operating results.\nOur business depends on strong brands, and failing to maintain and enhance our brands would hurt our ability to expand our base of users, advertisers, customers, content providers, and other partners.","sentences":[7,9]},{"passage_id":"0001652044-26-000018:1:15","accession":"0001652044-26-000018","item":"1","char_start":27481,"char_end":28168,"quote":"•users, for whom other products and services are literally one click away, on the basis of the relevance of our advertising, as well as the general usefulness, security, and availability of our products and services;\n•advertisers, primarily based on our ability to generate sales leads, and ultimately customers, and to deliver their advertisements in an efficient and effective manner across a variety of distribution channels even as trends in advertising mediums and user preferences change; and\n•content providers, primarily based on the quality of our advertiser base, our ability to help these partners generate revenues from advertising, and the terms of our agreements with them.","sentences":[8,10]}],"searches":[{"queries":["competition competitive","brand","market share","pricing power price increases","switching costs","patents intellectual property","scale cost advantage","network"],"items":["1","1A"],"seeded":true,"passage_ids":["0001652044-26-000018:1A:15","0001652044-26-000018:1A:9","0001652044-26-000018:1A:14","0001652044-26-000018:1A:10"]},{"queries":["market share rank users advertisers"],"items":["1"],"seeded":false,"passage_ids":["0001652044-26-000018:1:10","0001652044-26-000018:1:13","0001652044-26-000018:1:11","0001652044-26-000018:1:15"]}],"llm_calls":3,"tool_calls":4,"stop_reason":"submitted","usage":{"prompt_tokens":9493,"completion_tokens":370,"total_tokens":9863,"reasoning_tokens":0},"actual_cost_usd":0.0,"notional_cost_usd":0.0029282500000000003},"critic_status":"passed"},{"finding":{"criterion":"candid_management","verdict":"insufficient evidence","rationale":"The provided 10-K text focuses on potential risks, accounting policies, and external regulatory changes rather than providing a management-attributed account of a specific past failure or missed target. As a 10-K is a limited guide to candour, the evidence is insufficient to meet the criterion.","citations":[],"searches":[{"queries":["challenges","did not meet","below our expectations","we did not achieve","lessons","write-down of our investment","impairment","material weakness","restatement","decline decreased","we expect headwinds"],"items":["7","1A"],"seeded":true,"passage_ids":["0001652044-26-000018:1A:73","0001652044-26-000018:7:45","0001652044-26-000018:7:30","0001652044-26-000018:1A:22"]}],"llm_calls":1,"tool_calls":2,"stop_reason":"submitted","usage":{"prompt_tokens":2585,"completion_tokens":89,"total_tokens":2674,"reasoning_tokens":0},"actual_cost_usd":0.0,"notional_cost_usd":0.00077975},"critic_status":"passed_after_retry"},{"finding":{"criterion":"rational_capital_allocation","verdict":"evidence found","rationale":"The filing quantifies specific capital allocation actions in 2025, including $45.4 billion in share repurchases and $91.4 billion in capital expenditures. It also states that the primary use of capital is to invest for long-term growth and that management regularly evaluates the size, pace, and form of capital returns to stockholders.","citations":[{"passage_id":"0001652044-26-000018:7:20","accession":"0001652044-26-000018","item":"7","char_start":150578,"char_end":150957,"quote":"•Repurchases of Class A and Class C shares were $6.5 billion and $38.9 billion, respectively, totaling $45.4 billion for the year ended December 31, 2025.\n•Operating cash flow was $164.7 billion for the year ended December 31, 2025.\n•Capital expenditures, which primarily reflected investments in technical infrastructure, were $91.4 billion for the year ended December 31, 2025.","sentences":[2,4]},{"passage_id":"0001652044-26-000018:7:31","accession":"0001652044-26-000018","item":"7","char_start":163027,"char_end":163245,"quote":"The primary use of capital continues to be to invest for the long-term growth of the business. We regularly evaluate our cash and capital structure, including the size, pace, and form of capital return to stockholders.","sentences":[5,6]}],"searches":[{"queries":["share repurchases buyback","dividends","acquisitions","capital expenditures","return on invested capital","debt reduction"],"items":["7"],"seeded":true,"passage_ids":["0001652044-26-000018:7:33","0001652044-26-000018:7:5","0001652044-26-000018:7:20","0001652044-26-000018:7:31"]}],"llm_calls":1,"tool_calls":2,"stop_reason":"submitted","usage":{"prompt_tokens":2354,"completion_tokens":180,"total_tokens":2534,"reasoning_tokens":0},"actual_cost_usd":0.0,"notional_cost_usd":0.0008585},"critic_status":"passed"}],"critic":{"cik":"0001652044","ticker":"GOOGL","checks":[{"check":"R1","item":"G1","status":"pass","detail":"","owner":"explainer","attempt":0,"kind":null,"claims":[]},{"check":"R1","item":"G2","status":"pass","detail":"","owner":"explainer","attempt":0,"kind":null,"claims":[]},{"check":"R1","item":"G3","status":"pass","detail":"","owner":"explainer","attempt":0,"kind":null,"claims":[]},{"check":"R1","item":"G4","status":"pass","detail":"","owner":"explainer","attempt":0,"kind":null,"claims":[]},{"check":"R1","item":"G5","status":"pass","detail":"","owner":"explainer","attempt":0,"kind":null,"claims":[]},{"check":"R1","item":"G6","status":"pass","detail":"","owner":"explainer","attempt":0,"kind":null,"claims":[]},{"check":"R1","item":"G7","status":"pass","detail":"","owner":"explainer","attempt":0,"kind":null,"claims":[]},{"check":"R1","item":"B1","status":"pass","detail":"","owner":"explainer","attempt":0,"kind":null,"claims":[]},{"check":"R1","item":"B2","status":"pass","detail":"","owner":"explainer","at